<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ward & Room Allocation</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, Helvetica, sans-serif;
        }

        body{
            background:#f4f7fc;
        }

        header{
            background:#0d6efd;
            color:white;
            padding:20px;
            text-align:center;
        }

        .container{
            width:90%;
            margin:30px auto;
        }

        .card{
            background:white;
            padding:20px;
            margin-bottom:25px;
            border-radius:10px;
            box-shadow:0 2px 10px rgba(0,0,0,.1);
        }

        h2{
            color:#0d6efd;
            margin-bottom:15px;
        }

        form{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
            gap:15px;
        }

        input,select{
            padding:10px;
            border:1px solid #ccc;
            border-radius:5px;
            width:100%;
        }

        button{
            background:#0d6efd;
            color:white;
            border:none;
            padding:12px;
            border-radius:5px;
            cursor:pointer;
        }

        button:hover{
            background:#084298;
        }

        table{
            width:100%;
            border-collapse:collapse;
            margin-top:20px;
        }

        table th{
            background:#0d6efd;
            color:white;
            padding:12px;
        }

        table td{
            padding:10px;
            border:1px solid #ddd;
            text-align:center;
        }

        .deleteBtn{
            background:red;
        }

        .editBtn{
            background:green;
        }

        .action button{
            margin:2px;
        }
    </style>

</head>

<body>

<header>
    <h1>Hospital Management System</h1>
    <h3>Ward & Room Allocation</h3>
</header>

<div class="container">

    <div class="card">

        <h2>Add Ward</h2>

        <form id="wardForm">

            <input type="text" id="wardName" placeholder="Ward Name" required>

            <input type="number" id="capacity" placeholder="Capacity" required>

            <input type="number" id="occupiedBeds" placeholder="Occupied Beds" required>

            <button type="button" onclick="addWard()">Add Ward</button>

        </form>

    </div>

    <div class="card">

        <h2>Add Room Allocation</h2>

        <form id="roomForm">

            <input type="text" id="roomNumber" placeholder="Room Number">

            <select id="roomType">
                <option>General</option>
                <option>ICU</option>
                <option>Private</option>
                <option>Emergency</option>
            </select>

            <input type="number" id="bedCount" placeholder="Bed Count">

            <select id="status">
                <option>Available</option>
                <option>Occupied</option>
            </select>

            <button type="button" onclick="addRoom()">Allocate Room</button>

        </form>

    </div>

    <div class="card">

        <h2>Ward List</h2>

        <table id="wardTable">

            <thead>

            <tr>
                <th>ID</th>
                <th>Ward</th>
                <th>Capacity</th>
                <th>Occupied</th>
                <th>Action</th>
            </tr>

            </thead>

            <tbody>

            </tbody>

        </table>

    </div>

    <div class="card">

        <h2>Room Allocation List</h2>

        <table id="roomTable">

            <thead>

            <tr>
                <th>ID</th>
                <th>Room</th>
                <th>Type</th>
                <th>Beds</th>
                <th>Status</th>
                <th>Action</th>
            </tr>

            </thead>

            <tbody>

            </tbody>

        </table>

    </div>

</div>

<script>

    let wardId=1;
    let roomId=1;

    function addWard(){

        let name=document.getElementById("wardName").value;
        let capacity=document.getElementById("capacity").value;
        let occupied=document.getElementById("occupiedBeds").value;

        if(name==""||capacity==""){
            alert("Please fill all fields");
            return;
        }

        let table=document.querySelector("#wardTable tbody");

        let row=table.insertRow();

        row.innerHTML=`
<td>${wardId++}</td>
<td>${name}</td>
<td>${capacity}</td>
<td>${occupied}</td>
<td class="action">
<button class="editBtn" onclick="editRow(this)">Edit</button>
<button class="deleteBtn" onclick="deleteRow(this)">Delete</button>
</td>
`;

        document.getElementById("wardForm").reset();

    }

    function addRoom(){

        let room=document.getElementById("roomNumber").value;
        let type=document.getElementById("roomType").value;
        let beds=document.getElementById("bedCount").value;
        let status=document.getElementById("status").value;

        if(room==""){
            alert("Enter Room Number");
            return;
        }

        let table=document.querySelector("#roomTable tbody");

        let row=table.insertRow();

        row.innerHTML=`
<td>${roomId++}</td>
<td>${room}</td>
<td>${type}</td>
<td>${beds}</td>
<td>${status}</td>
<td class="action">
<button class="editBtn" onclick="editRow(this)">Edit</button>
<button class="deleteBtn" onclick="deleteRow(this)">Delete</button>
</td>
`;

        document.getElementById("roomForm").reset();

    }

    function deleteRow(btn){
        btn.parentElement.parentElement.remove();
    }

    function editRow(btn){

        let row=btn.parentElement.parentElement;

        alert("Edit functionality can be connected to your Spring Boot backend.");

    }

</script>

</body>
</html>